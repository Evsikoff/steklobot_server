# ---------------------------------------------------------------------------
# Обязательные секреты (в Northflank — Secret group, см. README)
# ---------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:AA...
TELEGRAM_MANAGER_CHAT_ID=-1001234567890
TELEGRAM_WEBHOOK_SECRET=придумайте-длинную-случайную-строку

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

GEMINI_API_KEY=AIza...

# --- Второй провайдер LLM (API Bazaar, OpenAI-совместимый) ---------------
# Нужны только если собираетесь переключаться на него в панели.
API_BAZAAR_URL=https://api.apibazaar.shop/v1
API_BAZAAR_KEY=
API_BAZAAR_MODEL=gpt-5.6-luna
# response_format=json_object поддерживают не все модели за прокси; 1 — включить
API_BAZAAR_JSON_MODE=

PRICE_LIST_CSV_URL=https://docs.google.com/spreadsheets/d/<ID>/export?format=csv&gid=0

# --- Голосовые и фото ------------------------------------------------------
# Ключ тот же, что и GEMINI_API_KEY — отдельных секретов не нужно.
# 0 — выключить распознавание голосовых / фото
TRANSCRIBE_ENABLED=
VISION_ENABLED=

ADMIN_PASSWORD=пароль-для-входа-в-панель
SESSION_SECRET=ещё-одна-длинная-случайная-строка

# Публичный адрес сервиса — по нему сервер сам поставит webhook Telegram
PUBLIC_BASE_URL=https://<service>--<project>.code.run

# ---------------------------------------------------------------------------
# Необязательные настройки (у всех есть значения по умолчанию)
# ---------------------------------------------------------------------------
PORT=8080
GEMINI_MODEL=gemini-3.7-flash
# провайдер при самом первом старте, дальше значение берётся из базы
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_MS=45000
LLM_MAX_JSON_RETRIES=2
# Топики чата менеджеров, которые бот игнорирует (через запятую).
# По умолчанию 1,2 — служебные топики супергруппы. Пустое значение отключает фильтр.
TELEGRAM_IGNORED_TOPIC_IDS=1,2
# Распознавание готового Ogg-файла через Gemini Files API + Gemini 3.5 Transcribe
TRANSCRIBE_MODEL=gemini-3.5-transcribe
# Подсказка по языку (BCP-47, через запятую). Пусто — автоопределение
TRANSCRIBE_LANGUAGE_CODES=ru-RU
TRANSCRIBE_MAX_DURATION_SEC=600
TRANSCRIBE_TIMEOUT_MS=60000
# Распознавание фото автомобиля; по умолчанию берётся GEMINI_MODEL
VISION_MODEL=
VISION_TIMEOUT_MS=45000
# У думающих моделей рассуждение тратится из этого же лимита: на тесном бюджете
# ответ приходит пустым с finishReason=MAX_TOKENS
VISION_MAX_OUTPUT_TOKENS=2048
# Если фото/голос распознаны не дольше этого времени, сразу показать результат клиенту; 0 — отключить
RECOGNITION_QUICK_REPLY_MS=10000

ORCHESTRATOR_DEBOUNCE_MS=1200
ORCHESTRATOR_MAX_BATCH=10
HISTORY_LIMIT=20
PRICE_LIST_CACHE_TTL_MS=120000
SESSION_TTL_MS=604800000
